# Threshold for failed attempts
$threshold = 5
$timeframe = (Get-Date).AddHours(-1)

# Get failed logons (Event ID 4625) in last hour
$failedLogons = Get-WinEvent -FilterHashtable @{
    LogName = 'Security';
    Id      = 4625;
    StartTime = $timeframe
} | ForEach-Object {
    [PSCustomObject]@{
        TimeCreated = $_.TimeCreated
        User        = $_.Properties[5].Value
    }
}

# Group by user
$grouped = $failedLogons | Group-Object User | Where-Object { $_.Count -ge $threshold }

foreach ($userGroup in $grouped) {
    $user = $userGroup.Name
    Write-Host "User $user has $($userGroup.Count) failed logins. Resetting password..."

    # Generate strong random password
    $newPassword = [System.Web.Security.Membership]::GeneratePassword(12,3)

    try {
        # Reset AD password (requires RSAT / ActiveDirectory module)
        Set-ADAccountPassword -Identity $user -Reset -NewPassword (ConvertTo-SecureString $newPassword -AsPlainText -Force)
        # Optionally disable account for safety
        # Disable-ADAccount -Identity $user

        # Log to file
        Add-Content "C:\Reports\PasswordResets.log" "$(Get-Date): Reset password for $user. New Password: $newPassword"

        # Send email alert
        Send-MailMessage -To "soc@company.com" -From "automation@company.com" `
            -Subject "Password Reset Triggered for $user" `
            -Body "User $user reached $($userGroup.Count) failed logins. Password auto-reset to $newPassword." `
            -SmtpServer "smtp.company.com"

    } catch {
        Write-Error "Failed to reset password for $user. Error: $_"
    }
}
